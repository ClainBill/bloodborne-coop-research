+// ============================================================================
+// Game-facing P2PSocket (ORBIS_NET_SOCK_DGRAM_P2P), backed by the same shared
+// transport as the internal NP channels above. A socket "exists" as soon as
+// it's constructed (sys_socketex checks IsValid() immediately), but it only
+// becomes reachable once the game calls Bind() with a vport -- that's when we
+// register a receive queue and start actually being able to route it packets.
+// ============================================================================
+
+std::optional<net_socket> P2PSocket::Native() {
+    // Every P2P socket reports the transport's single readiness pipe fd
+    // here, not the raw UDP socket (see P2PTransport::ReadinessFd for why).
+    // sceNetEpollControl will end up registering that same fd multiple times
+    // (once per socket) against the real epoll set; sceNetEpollWait is what
+    // makes that actually resolve to the right per-socket events -- see the
+    // P2P handling added to it in net.cpp.
+    if (!P2PTransport::Instance().Ensure()) {
+        return {};
+    }
+    return P2PTransport::Instance().ReadinessFd();
+}
+
+bool P2PSocket::HasQueuedData() {
+    std::scoped_lock lock(m_mutex);
+    if (!bound_) {
+        return false;
+    }
+    return P2PTransport::Instance().VportHasData(bound_vport_);
+}
+
+int P2PSocket::Close() {
+    std::scoped_lock lock(m_mutex);
+    if (bound_) {
+        P2PTransport::Instance().UnregisterVport(bound_vport_);
+        bound_ = false;
+    }
+    return 0;
+}
+
+int P2PSocket::Bind(const OrbisNetSockaddr* addr, u32 addrlen) {
+    std::scoped_lock lock(m_mutex);
+    if (addr == nullptr || addrlen < sizeof(OrbisNetSockaddrIn)) {
+        LOG_ERROR(Lib_Net, "P2P bind: invalid addr/addrlen ({})", addrlen);
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+    if (!P2PTransport::Instance().Ensure()) {
+        LOG_ERROR(Lib_Net, "P2P bind: shared transport failed to open");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EADDRNOTAVAIL;
+        return -1;
+    }
+
+    const auto* orbis_addr = reinterpret_cast<const OrbisNetSockaddrIn*>(addr);
+    if (bound_) {
+        P2PTransport::Instance().UnregisterVport(bound_vport_);
+    }
+    bound_vport_ = orbis_addr->sin_vport;
+    bound_ = true;
+    P2PTransport::Instance().RegisterVport(bound_vport_);
+
+    LOG_INFO(Lib_Net, "P2P bind: vport={} (game requested port={})",
+             sceNetNtohs(bound_vport_), sceNetNtohs(orbis_addr->sin_port));
+    return 0;
+}
+
+int P2PSocket::SendPacket(const void* msg, u32 len, int flags, const OrbisNetSockaddr* to,
+                          u32 tolen) {
+    std::scoped_lock lock(m_mutex);
+    if (!bound_) {
+        LOG_ERROR(Lib_Net, "P2P sendto: socket not bound to a vport yet");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EDESTADDRREQ;
+        return -1;
+    }
+    if (to == nullptr || tolen < sizeof(OrbisNetSockaddrIn)) {
+        LOG_ERROR(Lib_Net, "P2P sendto: missing/short destination address (tolen={})", tolen);
+        *Libraries::Kernel::__Error() = ORBIS_NET_EDESTADDRREQ;
+        return -1;
+    }
+
+    const auto* orbis_to = reinterpret_cast<const OrbisNetSockaddrIn*>(to);
+    const int rc = P2PTransport::Instance().SendVport(bound_vport_, orbis_to->sin_vport, msg, len,
+                                                       orbis_to->sin_addr, orbis_to->sin_port);
+    if (rc < 0) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EAGAIN;
+        return -1;
+    }
+    return rc;
+}
+
+int P2PSocket::ReceivePacket(void* buf, u32 len, int flags, OrbisNetSockaddr* from, u32* fromlen) {
+    std::scoped_lock lock(receive_mutex);
+    if (!bound_) {
+        LOG_ERROR(Lib_Net, "P2P recvfrom: socket not bound to a vport yet");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EBADF;
+        return -1;
+    }
+
+    // The transport's own receiver thread continuously drains the shared
+    // socket into per-vport queues (see P2PTransport::ReceiverLoop), so we
+    // just need to pop from ours.
+    u32 from_addr = 0;
+    u16 from_port = 0;
+    u16 from_vport = 0;
+    const int rc = P2PTransport::Instance().RecvVport(bound_vport_, buf, len, &from_addr,
+                                                       &from_port, &from_vport);
+    if (rc < 0) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EWOULDBLOCK;
+        return -1;
+    }
+
+    if (from != nullptr) {
+        auto* orbis_from = reinterpret_cast<OrbisNetSockaddrIn*>(from);
+        std::memset(orbis_from, 0, sizeof(OrbisNetSockaddrIn));
+        orbis_from->sin_len = sizeof(OrbisNetSockaddrIn);
+        orbis_from->sin_family = ORBIS_NET_AF_INET;
+        orbis_from->sin_addr = from_addr;
+        orbis_from->sin_port = from_port;
+        orbis_from->sin_vport = from_vport;
+        if (fromlen) {
+            *fromlen = sizeof(OrbisNetSockaddrIn);
+        }
+    }
+    LOG_DEBUG(Lib_Net, "P2P recvfrom: {} bytes on vport {} from {:#x}:{} (peer vport={})", rc,
+              sceNetNtohs(bound_vport_), from_addr, sceNetNtohs(from_port), sceNetNtohs(from_vport));
+    return rc;
+}
+
+int P2PSocket::Connect(const OrbisNetSockaddr* addr, u32 namelen) {
+    std::scoped_lock lock(m_mutex);
+    if (addr == nullptr || namelen < sizeof(OrbisNetSockaddrIn)) {
+        LOG_ERROR(Lib_Net, "P2P connect: invalid addr/addrlen ({})", namelen);
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+    const auto* orbis_addr = reinterpret_cast<const OrbisNetSockaddrIn*>(addr);
+    connected_addr_ = orbis_addr->sin_addr;
+    connected_port_ = orbis_addr->sin_port;
+    connected_vport_ = orbis_addr->sin_vport;
+    connected_ = true;
+    LOG_INFO(Lib_Net, "P2P connect: peer vport={} addr={:#x}:{}", sceNetNtohs(orbis_addr->sin_vport),
+             orbis_addr->sin_addr, sceNetNtohs(orbis_addr->sin_port));
+    return 0;
+}
+
+int P2PSocket::SendMessage(const OrbisNetMsghdr* msg, int flags) {
+    std::scoped_lock lock(m_mutex);
+    if (!bound_) {
+        LOG_ERROR(Lib_Net, "P2P sendmsg: socket not bound to a vport yet");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EDESTADDRREQ;
+        return -1;
+    }
+    if (msg == nullptr) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+
+    u32 dest_addr = 0;
+    u16 dest_port = 0;
+    u16 dest_vport = 0;
+    if (msg->msg_name != nullptr && msg->msg_namelen >= sizeof(OrbisNetSockaddrIn)) {
+        const auto* to = reinterpret_cast<const OrbisNetSockaddrIn*>(msg->msg_name);
+        dest_addr = to->sin_addr;
+        dest_port = to->sin_port;
+        dest_vport = to->sin_vport;
+    } else if (connected_) {
+        dest_addr = connected_addr_;
+        dest_port = connected_port_;
+        dest_vport = connected_vport_;
+    } else {
+        LOG_ERROR(Lib_Net, "P2P sendmsg: no destination (msg_name null and socket not connected)");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EDESTADDRREQ;
+        return -1;
+    }
+
+    std::array<u8, kMaxDatagram> gathered;
+    u32 total = 0;
+    for (int i = 0; i < msg->msg_iovlen; ++i) {
+        const auto& iov = msg->msg_iov[i];
+        if (total + iov.iov_len > gathered.size()) {
+            LOG_ERROR(Lib_Net, "P2P sendmsg: message too large ({}+ bytes)", total + iov.iov_len);
+            *Libraries::Kernel::__Error() = ORBIS_NET_EMSGSIZE;
+            return -1;
+        }
+        std::memcpy(gathered.data() + total, iov.iov_base, iov.iov_len);
+        total += static_cast<u32>(iov.iov_len);
+    }
+
+    const int rc = P2PTransport::Instance().SendVport(bound_vport_, dest_vport, gathered.data(),
+                                                       total, dest_addr, dest_port);
+    if (rc < 0) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EAGAIN;
+        return -1;
+    }
+    return rc;
+}
+
+int P2PSocket::ReceiveMessage(OrbisNetMsghdr* msg, int flags) {
+    std::scoped_lock lock(receive_mutex);
+    if (!bound_) {
+        LOG_ERROR(Lib_Net, "P2P recvmsg: socket not bound to a vport yet");
+        *Libraries::Kernel::__Error() = ORBIS_NET_EBADF;
+        return -1;
+    }
+    if (msg == nullptr || msg->msg_iov == nullptr || msg->msg_iovlen <= 0) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+
+    std::array<u8, kMaxDatagram> received;
+    u32 from_addr = 0;
+    u16 from_port = 0;
+    u16 from_vport = 0;
+    const int rc = P2PTransport::Instance().RecvVport(
+        bound_vport_, received.data(), static_cast<u32>(received.size()), &from_addr, &from_port,
+        &from_vport);
+    if (rc < 0) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EWOULDBLOCK;
+        return -1;
+    }
+
+    u32 copied = 0;
+    const u32 total = static_cast<u32>(rc);
+    for (int i = 0; i < msg->msg_iovlen && copied < total; ++i) {
+        const auto& iov = msg->msg_iov[i];
+        const u32 chunk = std::min<u32>(static_cast<u32>(iov.iov_len), total - copied);
+        std::memcpy(iov.iov_base, received.data() + copied, chunk);
+        copied += chunk;
+    }
+
+    if (msg->msg_name != nullptr && msg->msg_namelen >= sizeof(OrbisNetSockaddrIn)) {
+        auto* orbis_from = reinterpret_cast<OrbisNetSockaddrIn*>(msg->msg_name);
+        std::memset(orbis_from, 0, sizeof(OrbisNetSockaddrIn));
+        orbis_from->sin_len = sizeof(OrbisNetSockaddrIn);
+        orbis_from->sin_family = ORBIS_NET_AF_INET;
+        orbis_from->sin_addr = from_addr;
+        orbis_from->sin_port = from_port;
+        orbis_from->sin_vport = from_vport;
+        msg->msg_namelen = sizeof(OrbisNetSockaddrIn);
+    }
+    LOG_DEBUG(Lib_Net, "P2P recvmsg: {} bytes on vport {} from {:#x}:{} (peer vport={})", copied,
+              sceNetNtohs(bound_vport_), from_addr, sceNetNtohs(from_port), sceNetNtohs(from_vport));
+    return static_cast<int>(copied);
+}
+
+int P2PSocket::GetSocketAddress(OrbisNetSockaddr* name, u32* namelen) {
+    std::scoped_lock lock(m_mutex);
+    if (name == nullptr || namelen == nullptr || *namelen < sizeof(OrbisNetSockaddrIn)) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+    auto* orbis_name = reinterpret_cast<OrbisNetSockaddrIn*>(name);
+    std::memset(orbis_name, 0, sizeof(OrbisNetSockaddrIn));
+    orbis_name->sin_len = sizeof(OrbisNetSockaddrIn);
+    orbis_name->sin_family = ORBIS_NET_AF_INET;
+    orbis_name->sin_addr = GetP2PAdvertisedAddr();
+    orbis_name->sin_port = sceNetHtons(GetP2PConfiguredPort());
+    orbis_name->sin_vport = bound_vport_;
+    *namelen = sizeof(OrbisNetSockaddrIn);
+    return 0;
+}
+
+int P2PSocket::GetPeerName(OrbisNetSockaddr* addr, u32* namelen) {
+    std::scoped_lock lock(m_mutex);
+    if (!connected_) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_ENOTCONN;
+        return -1;
+    }
+    if (addr == nullptr || namelen == nullptr || *namelen < sizeof(OrbisNetSockaddrIn)) {
+        *Libraries::Kernel::__Error() = ORBIS_NET_EINVAL;
+        return -1;
+    }
+    auto* orbis_addr = reinterpret_cast<OrbisNetSockaddrIn*>(addr);
+    std::memset(orbis_addr, 0, sizeof(OrbisNetSockaddrIn));
+    orbis_addr->sin_len = sizeof(OrbisNetSockaddrIn);
+    orbis_addr->sin_family = ORBIS_NET_AF_INET;
+    orbis_addr->sin_addr = connected_addr_;
+    orbis_addr->sin_port = connected_port_;
+    orbis_addr->sin_vport = connected_vport_;
+    *namelen = sizeof(OrbisNetSockaddrIn);
+    return 0;
+}
+
 } // namespace Libraries::Net
